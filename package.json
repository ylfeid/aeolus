{
  "name": "aeolus",
  "version": "1.0.0",
  "description": "A real-time GPU wind tunnel: lattice Boltzmann CFD with LES turbulence modelling, running in the browser with WebGPU.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
